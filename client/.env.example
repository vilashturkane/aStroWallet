# Run ../script/deploy.sh to build + upload the contract WASM — it fills this in
NEXT_PUBLIC_TOKEN_WASM_HASH=


# Pinata credentials — image/metadata upload (get JWT from https://app.pinata.cloud/developers/api-keys)
# Pinata credentials (https://app.pinata.cloud/developers/api-keys)
# Preferred: JWT (uses the current v3 Files API)
PINATA_JWT=
# Fallback: API key + secret (legacy pinning API)
PINATA_KEY=
PINATA_SECRET=
# Optional: your dedicated gateway domain, e.g. example.mypinata.cloud
PINATA_GATEWAY=gateway.pinata.cloud


PINATA_GATEWAY=
